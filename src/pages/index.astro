---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const introText =
  "I research humans and use design to make them fall in love with tech. Exploring the intersection of cognitive science and digital experiences.";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Abel Angel — Portfolio"
  bodyClass="zoom-home"
  navBrandVisible={false}
>
  <main id="home" data-load-stagger>
    <!-- Nav + brand wordmark now live in the shared SiteHeader (via
         BaseLayout). The home scroll-fade below still reveals the wordmark by
         toggling `.visible` on #brandMark / #brandHeart. -->

    <!-- ── Layer 1 (bottom): the intro message. Fixed in place; the grid
         slides up over it and it fades out as it's covered. ── -->
    <div class="hero" id="introFade">
      <h1 class="hero-title" data-load-item>
        <span>Hey! I'm </span><span>Abel Angel</span>
      </h1>
      <div class="hero-sub" data-load-item>
        <span class="intro-line">{introText}</span>
      </div>
    </div>

    <!-- Scroll hint: "Projects" label above a downward arrow (with tail),
         centred at the bottom of the first screen. Clicking it jumps up to the
         first project in the list. Fades out as you scroll. -->
    <button class="scroll-hint" id="scrollHint" type="button" aria-label="Jump to projects">
      <span class="scroll-hint-label">Projects</span>
      <svg width="22" height="24" viewBox="0 0 22 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 6 V 15 M6 10 l5 5 5-5"></path>
      </svg>
    </button>

    <!-- Reserves the first-screen height so the showcase starts peeking at
         the bottom of the viewport. -->
    <div class="hero-spacer"></div>

    <!-- ── Project rows: text left (30%) / photo right (70%). Opaque, in
         normal flow, so it slides up and covers the message like a sheet of
         paper. ── -->
    <section class="showcase">
      {
        projects.map((p) => {
          const soon = p.data.status === "coming-soon";
          const Tag = soon ? "div" : "a";
          const props = soon ? {} : { href: p.data.href };
          return (
            <Tag class:list={["show-row", soon && "show-row--soon"]} {...props}>
              <div class="show-text">
                <div class="show-title">{p.data.title}</div>
                <div class="show-desc">{p.data.tagline}</div>
                <div class="show-tags">
                  {soon && <span class="show-tag show-tag--soon">Coming Soon</span>}
                  {p.data.tags.map((t) => (
                    <span class="show-tag">{t}</span>
                  ))}
                </div>
              </div>

              <div class="show-media">
                <div class="show-cover">
                  {p.data.variant === "cover" ? (
                    <div
                      class="show-frame show-frame--cover"
                      style={`background:${p.data.coverBg};`}
                    >
                      <span
                        class="show-frame-label"
                        style={`color:${p.data.coverFg};`}
                      >
                        {p.data.coverLabel}
                      </span>
                    </div>
                  ) : (
                    <div
                      class="show-frame"
                      style={
                        p.data.coverBg ? `background:${p.data.coverBg};` : undefined
                      }
                    >
                      <div
                        class:list={[
                          "show-photo",
                          `show-photo--${p.data.coverFit}`,
                        ]}
                        style={`background-image:url(${p.data.coverImage});`}
                      />
                    </div>
                  )}
                </div>
              </div>
            </Tag>
          );
        })
      }
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* Home + About share the original 1.2 zoom, applied via a body class. */
  body.zoom-home {
    zoom: 1.2;
  }
</style>

<style>
  /* Home body text is Open Sans; scoped to this page — the rest of the site
     keeps Inter. Nav/brand (Space Grotesk) live in the shared SiteHeader. */
  #home {
    font-family: "Open Sans", system-ui, -apple-system, sans-serif;
  }
  /* Headers/titles use Lastik — tighter tracking. Lastik Free is a single-
     weight font, so font-weight can't make it heavier; a same-colour text
     stroke thickens the glyphs to add visual weight. */
  .hero-title,
  .hero-sub,
  .show-title {
    font-family: "Lastik", system-ui, sans-serif;
    letter-spacing: -0.02em;
    -webkit-text-stroke: 0.4px currentColor;
    paint-order: stroke fill;
  }
</style>

<style>
  /* ═══ Three stacked layers ═══
     The home screen behaves like two sheets of paper: the intro message
     sits underneath, and the project grid slides up over it as you scroll
     (which is why the message fades). The nav is a third layer that always
     stays on top. z-index: header (30) > grid (20) > message (10). */

  /* ── Layer 1: intro message (fixed underneath, fades on scroll) ── */
  .hero {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Fills the visual viewport so the message can sit dead-centre. Divided by
       the body's 1.2 zoom so the box matches the real viewport height. */
    height: calc(100svh / 1.2);
    max-width: 1280px;
    margin: 0 auto;
    /* Extra bottom padding biases the vertical centring up by ~one line. */
    padding: 0 48px 80px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 10;
    pointer-events: none;
    text-align: center;
  }
  .hero-title {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0 auto 24px;
    color: #000;
    max-width: 620px;
    -webkit-text-stroke: 0.3px currentColor;
  }
  .hero-sub {
    font-size: 38px;
    font-weight: 800;
    color: #000;
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: 720px;
    margin: 0 auto;
    -webkit-text-stroke: 0.3px currentColor;
  }
  .intro-line { display: block; }

  /* Scroll hint — bottom-centre "Projects" label + down arrow with a gentle
     bob; light grey, clickable, fades on scroll. */
  .scroll-hint {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: #b5b5b0;
    cursor: pointer;
    padding: 6px 10px;
    background: none;
    border: 0;
    transition: opacity 0.3s ease, color 0.2s ease;
  }
  .scroll-hint:hover {
    color: #8f8f8a;
  }
  .scroll-hint-label {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: inherit;
  }

  /* Reserves first-screen height so the grid peeks at the bottom initially.
     Divided by the body's 1.2 zoom so the reserved box matches the visual
     viewport (zoom scales svh lengths again on render). */
  .hero-spacer {
    height: calc((100svh - 110px) / 1.2);
  }

  /* ── Layer 2: project grid (slides up and covers the message) ── */
  .grid-bleed {
    position: relative;
    z-index: 20;
    width: 100%;
    padding: 0 6px;
    box-sizing: border-box;
    /* Opaque so it fully occludes the message sliding underneath it. */
    background: #fffafa;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
    background: #fffafa;
  }

  .tile {
    position: relative;
    aspect-ratio: 3 / 2;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid #ccd4d8;
    /* 25% translucent (75% opaque). */
    background: rgba(229, 235, 238, 0.75);
    color: inherit;
    text-decoration: none;
  }
  .tile--soon { cursor: default; }

  .tile-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    /* Equal inset so the title sits the same distance from the top edge as
       from the left edge (line-height:1 on the title removes the extra
       leading above the text so the visual gaps match). */
    padding: 16px 16px 0;
  }
  .tile-title {
    font-size: 22px;
    font-weight: 800;
    color: #1c1c18;
    letter-spacing: -0.016em;
    line-height: 1;
  }
  .tile-tags {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 60%;
    text-align: right;
  }
  .tag-list { font-size: 14px; color: #71717a; line-height: 1.4; }
  .tag-soon {
    font-size: 13px;
    font-weight: 700;
    color: #1c1c18;
    white-space: nowrap;
  }

  .tile-body {
    position: relative;
    flex: 1;
    margin-top: 20px;
  }

  .frame {
    position: absolute;
    top: 0;
    left: 32px;
    width: 68%;
    aspect-ratio: 3 / 2;
    background: #fffafa;
    border: 2px solid #1c1c18;
    border-radius: 4px;
    box-shadow: 0 12px 28px -14px rgba(28, 28, 24, 0.35);
    overflow: hidden;
  }
  .frame--cover {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    box-shadow: none;
  }
  .frame-label {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .frame-photo {
    position: absolute;
    inset: 0;
    background-position: center;
    background-repeat: no-repeat;
  }
  .frame-photo--cover { background-size: cover; }
  .frame-photo--contain {
    inset: 14%;
    background-size: contain;
  }

  .tile:not(.tile--soon):hover .frame {
    transform: translateY(-4px);
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* ── Second style: horizontal rows — text (30%) left, photo (70%) right ── */
  .showcase {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    padding: 96px 48px 120px;
    /* Transparent so the (fading) message shows through as the rows slide up,
       instead of an opaque sheet covering it. */
    background: transparent;
  }
  .show-row {
    display: flex;
    /* Top-align the text so the title lines up with the top of the photo. */
    align-items: flex-start;
    gap: 40px;
    /* Vertical breathing room split top/bottom so the grey divider lands
       centred between two projects. */
    padding-block: 63px;
    color: inherit;
    text-decoration: none;
    /* Grey line above every project, including the first. */
    border-top: 1px solid rgba(28, 28, 24, 0.14);
  }
  .show-row:last-child { padding-bottom: 0; }
  .show-row--soon { cursor: default; }

  .show-text {
    flex: 0 0 30%;
    max-width: 30%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .show-title {
    font-size: 38px;
    font-weight: 700;
    color: #1c1c18;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .show-desc { font-size: 15px; font-weight: 700; color: #71717a; line-height: 1.6; }
  .show-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
  .show-tag {
    font-size: 12px;
    color: #1c1c18;
    background: transparent;
    border: 1px solid rgba(28, 28, 24, 0.25);
    padding: 4px 11px;
    border-radius: 999px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .show-tag--soon {
    color: #fffafa;
    background: #1c1c18;
    border-color: #1c1c18;
    font-weight: 600;
  }

  /* Fill the space left of the text column instead of a fixed 70% — a fixed
     70% + the 40px gap sums past 100% (flex-shrink is 0), pushing the box past
     the right padding. Growing keeps its right edge inside the padding so it
     matches the left. */
  .show-media { flex: 1 1 auto; min-width: 0; }
  /* Grey box (same size as the photo used to be); the photo is shrunk to a
     "screen" centred inside it — same idea as the grid tiles. */
  .show-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid #ccd4d8;
    background: rgba(229, 235, 238, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* The shrunk screen sitting in the centre of the grey box. */
  .show-frame {
    position: relative;
    width: 52%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 6px;
    background: #fffafa;
    border: 2px solid #1c1c18;
    box-shadow: 0 14px 32px -18px rgba(28, 28, 24, 0.45);
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }
  .show-frame--cover {
    border: none;
    box-shadow: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .show-row:not(.show-row--soon):hover .show-frame {
    transform: translateY(-4px);
  }
  .show-frame-label {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .show-photo {
    position: absolute;
    inset: 0;
    background-position: center;
    background-repeat: no-repeat;
  }
  .show-photo--cover { background-size: cover; }
  .show-photo--contain {
    inset: 12%;
    background-size: contain;
  }

  /* ── Mobile: drop the paper-slide effect. Everything flows normally in a
     single column; no fixed layers, no fade. ── */
  @media (max-width: 900px) {
    .hero {
      position: static;
      height: auto;
      justify-content: flex-start;
      align-items: stretch;
      text-align: left;
      max-width: none;
      padding: 24px 24px 40px;
      pointer-events: auto;
      opacity: 1 !important;
    }
    .hero-title, .hero-sub { max-width: none; }

    .hero-spacer { display: none; }

    .grid-bleed { position: static; padding: 0 24px; }
    .grid { grid-template-columns: 1fr; }
    .tile { aspect-ratio: 4 / 3; }

    /* Showcase stacks: text above the photo, both full width. */
    .showcase { padding: 56px 24px 72px; }
    .show-row {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding-block: 34px;
    }
    .show-text, .show-media { flex: none; max-width: none; }
  }
</style>

<script>
  const FADE_DISTANCE = 260;
  // The brand wordmark spells itself out over this fraction of a viewport
  // height of scrolling, revealing LETTERS_PER_STEP random letters at a time.
  const NAME_REVEAL_FRACTION = 0.9;
  const LETTERS_PER_STEP = 2;

  // Fisher–Yates shuffle — a fresh random letter order on every page load.
  function shuffle<T>(items: T[]): T[] {
    const a = items.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function initHeroFade() {
    const introEl = document.getElementById("introFade");
    const brandEl = document.getElementById("brandMark");
    const heartEl = document.getElementById("brandHeart");
    const hintEl = document.getElementById("scrollHint");
    if (!introEl || !brandEl) return;

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const isMobile = () => window.matchMedia("(max-width: 900px)").matches;
    const letters = shuffle(
      Array.from(brandEl.querySelectorAll<HTMLElement>(".brand-letter")),
    );
    const steps = Math.ceil(letters.length / LETTERS_PER_STEP);

    const update = () => {
      // Mobile / reduced-motion: no slide-over effect — message stays put and
      // fully visible, brand mark hidden.
      if (reduced || isMobile()) {
        introEl.style.opacity = "1";
        introEl.style.pointerEvents = "auto";
        brandEl.classList.remove("visible");
        heartEl?.classList.remove("visible");
        return;
      }
      const progress = Math.min(Math.max(window.scrollY / FADE_DISTANCE, 0), 1);
      introEl.style.opacity = String(1 - progress);
      // Selectable while fully visible at the top; becomes click-through once
      // it starts fading so the (invisible) fixed layer never blocks the
      // project content behind it.
      introEl.style.pointerEvents = progress > 0 ? "none" : "auto";

      // Name reveal: scroll position maps to a step count. Each step turns the
      // grey "next up" pair black and greys in the following pair of the
      // shuffled order, until the last pair lands black. Scrolling back up
      // plays it in reverse.
      const nameProgress = Math.min(
        Math.max(window.scrollY / (window.innerHeight * NAME_REVEAL_FRACTION), 0),
        1,
      );
      const solid =
        nameProgress > 0 ? Math.floor(nameProgress * steps) * LETTERS_PER_STEP : 0;
      const pending =
        nameProgress > 0 ? Math.min(solid + LETTERS_PER_STEP, letters.length) : 0;
      letters.forEach((el, i) => {
        el.classList.toggle("is-pending", i >= solid && i < pending);
        el.classList.toggle("is-hidden", i >= pending);
      });
      brandEl.classList.toggle("visible", pending > 0);
      heartEl?.classList.toggle("visible", nameProgress >= 1);
      // Scroll hint fades fully out the moment scrolling starts (the 0.3s CSS
      // transition on .scroll-hint animates it away). Once fading it also stops
      // catching clicks so it never blocks the project content behind it.
      if (hintEl) {
        hintEl.style.opacity = progress > 0 ? "0" : "1";
        hintEl.style.pointerEvents = progress > 0 ? "none" : "auto";
      }
    };

    // Clicking the hint jumps up to the first project in the list, aligning it
    // just below the fixed header.
    if (hintEl && !hintEl.dataset.wired) {
      hintEl.dataset.wired = "true";
      hintEl.addEventListener("click", () => {
        const firstRow = document.querySelector(".showcase .show-row");
        if (!firstRow) return;
        const HEADER_OFFSET = 96;
        const top =
          firstRow.getBoundingClientRect().top +
          window.scrollY -
          HEADER_OFFSET;
        window.scrollTo({ top, behavior: "smooth" });
      });
    }

    // Re-running on SPA nav: drop previous listeners before re-adding so they
    // don't stack up across navigations.
    if (window.__heroFadeHandler) {
      window.removeEventListener("scroll", window.__heroFadeHandler);
      window.removeEventListener("resize", window.__heroFadeHandler);
    }
    window.__heroFadeHandler = update;
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  // ── Return-to-project scroll restore ──
  // When a project card is opened, remember its href. Coming back to the home
  // page (e.g. via a case study's "Back" link) then lands the visitor on that
  // same project instead of at the top.
  const RETURN_KEY = "homeScrollTo";

  function wireProjectReturn() {
    const showcase = document.querySelector<HTMLElement>(".showcase");
    if (!showcase || showcase.dataset.returnWired) return;
    showcase.dataset.returnWired = "true";
    showcase.addEventListener("click", (e) => {
      const row = (e.target as HTMLElement).closest<HTMLAnchorElement>("a.show-row");
      const href = row?.getAttribute("href");
      if (href) sessionStorage.setItem(RETURN_KEY, href);
    });
  }

  function scrollToProject(target: string) {
    const row = document.querySelector<HTMLElement>(
      `.showcase a.show-row[href="${target}"]`,
    );
    if (!row) return false;
    const HEADER_OFFSET = 96;
    const top =
      row.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET;
    // Jump (not smooth) so it feels like you never left that spot.
    window.scrollTo({ top, behavior: "auto" });
    // Sync the intro fade / brand mark to the restored scroll position.
    window.__heroFadeHandler?.();
    return true;
  }

  function restoreProjectScroll() {
    // `astro:page-load` fires on every page, but this only applies to the home
    // showcase. Bail out *without* consuming the stored target when the
    // showcase isn't present — otherwise navigating into a case study would eat
    // the value before we ever return home.
    if (!document.querySelector(".showcase")) return;
    const target = sessionStorage.getItem(RETURN_KEY);
    if (!target) return;
    sessionStorage.removeItem(RETURN_KEY);
    // The View Transitions router resets scroll to the top around the swap —
    // re-assert our scroll on the next few frames so it lands (and stays) on
    // the opened project.
    let frames = 5;
    const assert = () => {
      scrollToProject(target);
      if (--frames > 0) requestAnimationFrame(assert);
    };
    assert();
  }

  function initHome() {
    initHeroFade();
    wireProjectReturn();
    restoreProjectScroll();
  }

  initHome();
  if (!window.__heroFadeWired) {
    window.__heroFadeWired = true;
    document.addEventListener("astro:page-load", initHome);
  }
</script>
