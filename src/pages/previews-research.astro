---
// Scratch page for the "Underlying research" preview, on the unit grid
// (1 unit = the 480 x 322 tile in the Binu case study).
import { ResearchTile } from "../components/previews/UnderlyingResearch";
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Previews: research</title>
    <style>
      body { margin: 0; background: #fff; font-family: Geist, system-ui, sans-serif; color: #16181a; }
      main { max-width: 976px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: 48px; }
      h2 { font-size: 15px; font-weight: 500; color: #5e6368; margin: 0 0 12px; }
      .units { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 322px; gap: 16px; }
      .unit { border: 1.5px dashed #c9cbc6; border-radius: 20px; background: #f8f8f6; }
      .row { display: flex; gap: 16px; }
      .row > * { flex: 1 1 363px; height: 322px; }
      @media (max-width: 679px) {
        .units { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
        .units > * { min-height: 322px; }
        .row { flex-direction: column; }
        .row > * { flex: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <section>
        <h2>Underlying research, 1×1</h2>
        <div class="units">
          <div class="unit"></div>
          <div><ResearchTile client:visible /></div>
        </div>
      </section>
      <section>
        <h2>Underlying research, 350px phone column</h2>
        <div style="width: 350px; height: 322px"><ResearchTile client:visible /></div>
      </section>
    </main>
  </body>
</html>
