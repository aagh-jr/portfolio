---
// Scratch page for the search-states previews, on the 480 x 322 unit grid.
import { SearchLoadingTile, SearchEmptyTile } from "../components/previews/SearchStates";
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Search states previews</title>
    <style>
      body { margin: 0; background: #fff; font-family: Geist, system-ui, sans-serif; color: #16181a; }
      main { max-width: 976px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: 48px; }
      h2 { font-size: 15px; font-weight: 500; color: #5e6368; margin: 0 0 12px; }
      .units { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 322px; gap: 16px; }
      @media (max-width: 679px) {
        .units { grid-template-columns: minmax(0, 1fr); }
      }
    </style>
  </head>
  <body>
    <main>
      <section>
        <h2>Search states, 1×1 (loading, empty)</h2>
        <div class="units">
          <div><SearchLoadingTile client:visible /></div>
          <div><SearchEmptyTile client:visible /></div>
        </div>
      </section>
    </main>
  </body>
</html>
