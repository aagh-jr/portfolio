---
// Scratch page for the skin-profile previews (Binu case study, D04): each
// tile at the 1x1 unit (480 x 322) and at the row's 422 height.
import { NeedsTile, ProfileSavedTile } from "../components/previews/SkinNeeds";
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Previews: skin needs</title>
    <style>
      body { margin: 0; background: #fff; font-family: Geist, system-ui, sans-serif; color: #16181a; }
      main { max-width: 976px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: 48px; }
      h2 { font-size: 15px; font-weight: 500; color: #5e6368; margin: 0 0 12px; }
      .units { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 322px; gap: 16px; }
      .units--tall { grid-auto-rows: 422px; }
      .unit { border: 1.5px dashed #c9cbc6; border-radius: 20px; background: #f8f8f6; }
      @media (max-width: 679px) {
        .units { grid-template-columns: minmax(0, 1fr); }
      }
    </style>
  </head>
  <body>
    <main>
      <section>
        <h2>Independent needs + profile saved, 1×1 (322 high)</h2>
        <div class="units">
          <div><NeedsTile client:visible /></div>
          <div><ProfileSavedTile client:visible /></div>
        </div>
      </section>
      <section>
        <h2>Same, at the D04 row height (422)</h2>
        <div class="units units--tall">
          <div><NeedsTile client:visible /></div>
          <div><ProfileSavedTile client:visible /></div>
        </div>
      </section>
    </main>
  </body>
</html>
