---
// The About section, for now: two piles of cards side by side, photos on the
// left and note cards (the letter's paper, its hills border and all) on the
// right. Scrolling in, the cards drop onto their piles, bottom first; once the
// section pins, each layer peels off both piles at once, the photos out to
// the left, the notes out to the right, until both are gone and the page moves
// on. Without JS, or with reduced motion, the cards simply sit in two columns.

const photos = [
  { src: "/uploads/abel-portrait.jpg", caption: "Hey, that's me" },
  { tone: "#9fb0b8", caption: "UC San Diego" },
  { tone: "#a7ad95", caption: "Cabrillo National Monument" },
];

const notes = [
  {
    title: "About Me",
    paragraphs: [
      "I’m a San Jose native and a first gen college graduate from UC San Diego. As a kid I was both a tech nerd and a crafty kid. I grew up in the golden age of YouTube, and my feed was filled with iJustine tech reviews alongside art, DIY and craft videos. To this day I credit those spaces with shaping who I am.",
      "What I enjoy most is researching, designing and building for people who may not realize technology can solve their problems. SkinSavior is a good example. Plenty of skincare apps exist, but most people don’t realize they could get much more out of them, like actually understanding what’s in their products and how well the research backs it up. So I took ingredient research and packaged it in a way non-scientists can understand. People often don’t know they can get more out of the technology they already have, and someone has to find that gap and build for it. Whether a product is sold to a company or to a single person, someone ends up using it every day, and that person is who I design for. Most of the time they aren’t experts, so the part I enjoy most is taking something complex and making it make sense to them.",
      "My goal is to make people as in love with tech as I was as a kid. Between my technical, design and product coursework, I understand how the things I build work, like how a RAG pipeline pulls in information or how to clean a dataset before analyzing it, and I use AI tools to help with the code. I’m now looking to support teams that build user-facing products, services and tools, whether in product management, user experience or the growing design engineering space.",
    ],
  },
  {
    title: "Academics",
    paragraphs: [
      "Since I was a creative kid, I fancied the idea of majoring in graphic design or fashion design. But I also excelled at the sciences in high school, and at 17 I interpreted that as passion. Between that and the academic pressure, I started college as a Biochemistry major, but I soon realized my passion was not with the atoms. My interest in the life sciences never fully left, though, and it still shows up in my work today.",
      "While looking for a new path, I took The Design of Everyday Things, a class created by Don Norman, the same person who wrote the book by that name. It was eye-opening because it showed me that design was more than posters and fashion. After that first class I knew Design and Interaction was the route I wanted to go, so I continued at UCSD as a Cognitive Science major specializing in Design and Interaction. It’s interesting to see how life can bring you back to square one but make it feel like a new adventure when you go in with a new mindset.",
    ],
  },
  {
    title: "Experience",
    paragraphs: [
      "During college I interned with the National Park Service at Cabrillo National Monument as a Science Educator for 2 school-year terms, supporting the interpretive and volunteer ranger. I designed and ran seasonal pop-up programs to get visitors engaging with educational content and with park staff. I also designed the print and digital materials that went with each program, which made them more hands-on, along with flyers to promote them on social media. Every program I ran offered Spanish-language facilitation so Spanish-speaking families could take part fully, and I wrote SOPs so future staff could keep running the programs after I left.",
      "A week after graduating, I started a contract role at Apple as a Research Coordinator supporting augmented reality research, where I moderated in-person usability sessions. Along the way I noticed some survey questions were confusing participants and some session steps were in an order that slowed data collection down. Working within the study protocol, I reworked the wording and resequenced the steps, which cut about 10 minutes of overtime per session and gave us clearer participant responses. I flagged what worked to my lead, who rolled the changes out to the other moderators. That contract has since come to an end.",
    ],
    links: true,
  },
];

// A slight, fixed tilt and nudge for each layer, so the piles look tossed.
const tilt = [
  [-2.5, -6, 4],
  [3, 8, -6],
  [-4, -10, 8],
  [2, 6, 10],
  [-1.5, -4, -8],
];
const pose = (i: number, side: number) => {
  const [r, x, y] = tilt[i % tilt.length];
  // order interleaves photo and note when the piles stack on narrow screens
  return `--r:${r * side}deg;--dx:${x * side}px;--dy:${y}px;--z:${photos.length - i};order:${i * 2 + (side > 0 ? 1 : 0)};`;
};
---

<div class="piles" style={`--n:${photos.length};`}>
  <div class="piles-stage">
    <div class="pile pile--photos" data-side="-1">
      {
        photos.map((p, i) => (
          <figure class="card photo" style={pose(i, -1)}>
            {p.src ? (
              <img src={p.src} alt="Abel Angel" loading="lazy" decoding="async" />
            ) : (
              <div class="photo-blank" style={`--tone:${p.tone};`} role="img" aria-label={`Photo placeholder: ${p.caption}`} />
            )}
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="pile pile--notes" data-side="1">
      {
        notes.map((n, i) => (
          <div class="card note-card" style={pose(i, 1)}>
            <div class="note-paper">
              <h3 class="note-title">{n.title}</h3>
              {n.paragraphs.map((t) => <p class="note-text">{t}</p>)}
              {n.links && (
                <p class="note-links">
                  <a href="mailto:abel.aagh@gmail.com">Email</a>
                  <a href="https://www.linkedin.com/in/abel-a-gonzalez" target="_blank" rel="noreferrer">LinkedIn</a>
                  <a href="https://github.com/aagh-jr" target="_blank" rel="noreferrer">GitHub</a>
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* ── Without JS (or with reduced motion): two plain columns of cards ── */
  .piles-stage {
    width: var(--grid);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--gutter);
    padding: 88px 0 0;
  }
  .pile {
    container-type: inline-size;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 48px;
  }
  .card {
    margin: 0;
    rotate: var(--r);
  }

  /* ── Piled (initPiles): the section is a tall runway, the stage pinned to
     the screen while it scrolls by; every card sits in the same cell. ── */
  .piles.is-piled {
    height: calc(100svh + var(--n) * 60svh);
  }
  .is-piled .piles-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    box-sizing: border-box;
    padding: 88px var(--gutter) 48px;
    grid-template-columns: 2fr 3fr;
    overflow: clip;
  }
  .is-piled .pile {
    align-content: center;
    align-items: center;
  }
  /* Every note as tall as the longest, so none sticks out of the pile */
  .is-piled .pile--notes {
    align-items: stretch;
  }
  .is-piled .note-card {
    display: flex;
  }
  .is-piled .note-paper {
    flex: 1;
  }
  .is-piled .card {
    grid-area: 1 / 1;
    cursor: pointer;
    z-index: var(--z);
    rotate: none;
    will-change: transform;
    /* Placed by initPiles; this is where each rests on its pile */
    transform: translate(var(--dx), var(--dy)) rotate(var(--r));
  }

  /* ── Photos: printed on a white border, like a snapshot ── */
  .photo {
    --lift: 0;
    width: min(100%, 380px, (100svh - 220px) * 0.78);
    box-sizing: border-box;
    padding: 4.5% 4.5% 0;
    background: #fbfaf6;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px rgb(28 28 24 / 0.06),
      0 calc(2px + 22px * var(--lift)) calc(4px + 36px * var(--lift)) rgb(28 28 24 / calc(0.14 + 0.12 * var(--lift)));
  }
  .photo img,
  .photo-blank {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .photo-blank {
    background:
      radial-gradient(120% 90% at 30% 20%, rgb(255 255 255 / 0.35), transparent 60%),
      linear-gradient(160deg, var(--tone), color-mix(in srgb, var(--tone) 70%, #1c1c18));
  }
  .photo figcaption {
    padding: 0.9em 0 1.1em;
    font-family: var(--letter-font);
    letter-spacing: var(--letter-track);
    font-size: clamp(11px, 4cqi, 15px);
    color: #5e5d56;
  }

  /* ── Notes: the letter's paper, cut with the same hills border ── */
  .note-card {
    --lift: 0;
    width: min(100%, 760px);
    filter: drop-shadow(0 calc(1px + 16px * var(--lift)) calc(2px + 14px * var(--lift)) rgb(28 28 24 / calc(0.16 + 0.1 * var(--lift))));
  }
  .note-paper {
    box-sizing: border-box;
    padding: clamp(18px, 5cqi, 40px) clamp(16px, 5cqi, 40px);
    display: flex;
    flex-direction: column;
    background: var(--parchment, none) 0 0 / 384px, #e6e3db;
    font-family: var(--letter-font);
    letter-spacing: var(--letter-track);
    /* Long notes: sized to fit the card's width and the screen's height */
    font-size: clamp(11px, min(1.9cqi, 1.6svh), 15px);
    line-height: 1.55;
    color: #5e5d56;
  }
  .note-paper p { margin: 0; }
  .note-text + .note-text { margin-top: 0.9em; }
  .note-title {
    margin: 0 0 1em;
    font: inherit;
    font-size: 1.25em;
    color: #1c1c18;
  }
  .note-links {
    margin-top: auto !important;
    padding-top: 1.2em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.4em;
  }
  .note-links a {
    color: #1c1c18;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Narrow screens: one column, each photo above its note, no piling */
  @media (max-width: 760px) {
    .piles-stage {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 28px;
    }
    .pile { display: contents; }
    .photo { width: min(72%, 300px); }
    .note-card { width: 100%; margin-bottom: 20px; }
    .note-paper { font-size: 13px; }
  }
</style>

<script>
  // ── The piles: drop in, pin, peel off layer by layer ──
  // Entering (section top from the bottom of the screen to near the top),
  // the cards drop onto their piles, bottom card first. Then the stage pins
  // for the rest of the section's height, and its scroll is split into one
  // step per layer, with a short rest before the first and after the last.
  // In each step the top layer of both piles lifts and slides off its side.
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));

  // The letter's hills border (public/paper/main.js, BORDERS.hills): round
  // bumps all the way around, a round hill on each corner.
  function hillsPath(W: number, H: number, width = 16, d = 6, steps = 8) {
    const r = width / 2, e = Math.sqrt(r * r - (r - d) ** 2);
    const sides = [
      [{ x: r + e, y: d }, { x: W - r - e, y: d }, { x: 0, y: -1 }, { x: W - r, y: r }],
      [{ x: W - d, y: r + e }, { x: W - d, y: H - r - e }, { x: 1, y: 0 }, { x: W - r, y: H - r }],
      [{ x: W - r - e, y: H - d }, { x: r + e, y: H - d }, { x: 0, y: 1 }, { x: r, y: H - r }],
      [{ x: d, y: H - r - e }, { x: d, y: r + e }, { x: -1, y: 0 }, { x: r, y: r }],
    ];
    const pts: string[] = [];
    const add = (x: number, y: number) => pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
    sides.forEach(([A, B, n, C], j) => {
      const L = Math.hypot(B.x - A.x, B.y - A.y), ux = (B.x - A.x) / L, uy = (B.y - A.y) / L;
      const count = Math.max(1, Math.round(L / width)), w = L / count;
      add(A.x, A.y);
      for (let k = 0; k < count; k++)
        for (let i = 1; i <= steps; i++) {
          const t = (Math.PI * i) / steps;
          const along = w * (k + (1 - Math.cos(t)) / 2), out = d * Math.sin(t);
          add(A.x + ux * along + n.x * out, A.y + uy * along + n.y * out);
        }
      const next = sides[(j + 1) % 4][0];
      const a0 = Math.atan2(B.y - C.y, B.x - C.x);
      let a1 = Math.atan2(next.y - C.y, next.x - C.x);
      while (a1 <= a0) a1 += Math.PI * 2;
      for (let i = 1; i < steps * 2; i++) {
        const a = a0 + ((a1 - a0) * i) / (steps * 2);
        add(C.x + r * Math.cos(a), C.y + r * Math.sin(a));
      }
    });
    return `path('M${pts.join("L")}Z')`;
  }

  function cutNotes(root: HTMLElement) {
    const papers = root.querySelectorAll<HTMLElement>(".note-paper");
    const cut = () =>
      papers.forEach((p) => (p.style.clipPath = hillsPath(p.offsetWidth, p.offsetHeight)));
    cut();
    new ResizeObserver(cut).observe(root);
  }

  // The letter's parchment (public/paper/paper-texture.js), drawn once, off
  // the critical path; the notes show their plain paper color until then.
  function texture(root: HTMLElement) {
    const draw = (window as any).drawParchment;
    if (!draw) return;
    const run = () => root.style.setProperty("--parchment", `url(${draw(384).toDataURL()})`);
    "requestIdleCallback" in window ? requestIdleCallback(run, { timeout: 1500 }) : setTimeout(run, 300);
  }

  function initPiles() {
    const root = document.querySelector<HTMLElement>(".piles");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    texture(root);
    cutNotes(root);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    // Too narrow for the long notes to sit side by side: they stay stacked
    const narrow = matchMedia("(max-width: 760px)");

    const piles = [...root.querySelectorAll<HTMLElement>(".pile")].map((pile) => ({
      pile,
      side: Number(pile.dataset.side),
      // Each card with its resting tilt and nudge (from its --r, --dx, --dy)
      cards: [...pile.querySelectorAll<HTMLElement>(".card")].map((el) => {
        const st = getComputedStyle(el);
        const num = (k: string) => parseFloat(st.getPropertyValue(k)) || 0;
        return { el, pose: el.getAttribute("style") ?? "", r0: num("--r"), dx: num("--dx"), dy: num("--dy") };
      }),
      away: 0, // px to slide a card fully off screen
    }));
    const n = piles[0].cards.length;

    const measure = () => {
      for (const p of piles) {
        const box = p.pile.getBoundingClientRect();
        const mid = box.left + box.width / 2;
        const half = Math.max(...p.cards.map((c) => c.el.offsetWidth)) / 2;
        // Past the screen's edge, plus room for the tilt
        p.away = (p.side < 0 ? mid : innerWidth - mid) + half * 1.4 + 40;
      }
    };

    const update = () => {
      if (!root.isConnected || narrow.matches) return;
      const box = root.getBoundingClientRect();
      const vh = innerHeight;
      const enter = clamp01((vh - box.top) / (vh * 0.85));
      const run = Math.max(1, box.height - vh);
      const peel = clamp01(-box.top / run) * (n + 0.8) - 0.4;

      for (const { side, cards, away } of piles) {
        cards.forEach(({ el, r0, dx, dy }, i) => {
          const s = el.style;

          // Dropping onto the pile: bottom card (i = n - 1) first
          const landRaw = clamp01((enter - (n - 1 - i) * 0.1) / 0.45);
          const land = smooth(landRaw);
          // Peeling off: lift, then slide out, speeding up
          const raw = clamp01(peel - i);
          const lift = smooth(clamp01(raw / 0.3));
          const go = clamp01((raw - 0.12) / 0.88) ** 2;

          const x = dx + side * away * go;
          const y = dy - 70 * (1 - land) - 14 * lift + 30 * go;
          const rot = r0 + side * (3 * lift + 16 * go) + side * 6 * (1 - land);
          const scale = 1 + 0.08 * (1 - land) + 0.03 * lift;
          s.transform = `translate(${x}px, ${y}px) rotate(${rot}deg) scale(${scale})`;
          // Opaque early in the drop, so cards never show through each other
          s.opacity = String(clamp01(landRaw * 4));
          s.setProperty("--lift", String(Math.max(lift, 1 - land)));
          s.visibility = raw >= 1 ? "hidden" : "";
        });
      }
    };

    let queued = false;
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    const setMode = () => {
      root.classList.toggle("is-piled", !narrow.matches);
      if (narrow.matches)
        for (const { cards } of piles)
          for (const { el, pose } of cards) el.setAttribute("style", pose);
      measure();
      update();
    };
    // Clicking a card peels one layer, the same as scrolling down: scroll to
    // where the top layer has just finished sliding off.
    root.addEventListener("click", (e) => {
      if (narrow.matches || (e.target as Element).closest("a")) return;
      if (!(e.target as Element).closest(".card")) return;
      if (String(getSelection() ?? "")) return; // selecting text, not peeling
      const box = root.getBoundingClientRect();
      const run = Math.max(1, box.height - innerHeight);
      const peel = clamp01(-box.top / run) * (n + 0.8) - 0.4;
      // A layer that's mostly off already counts as gone
      const next = Math.min(n, Math.max(0, Math.floor(peel + 0.3)) + 1);
      const at = (next + 0.45) / (n + 0.8);
      scrollTo({ top: scrollY + box.top + run * at, behavior: "smooth" });
    });

    setMode();
    narrow.addEventListener("change", setMode);
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", () => {
      measure();
      queue();
    });
  }

  initPiles();
  document.addEventListener("astro:page-load", initPiles);
</script>
