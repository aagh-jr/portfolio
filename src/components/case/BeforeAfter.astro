---
// Two same-sized screenshots stacked; drag the round "< >" handle (or use
// the arrow keys) to wipe between them. "After" sits underneath, "before" is
// clipped on top from the left. Each label is clipped with its own side.
export interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  /** Image aspect ratio, e.g. "16 / 10". */
  ratio?: string;
  caption?: string;
  class?: string;
}
const {
  before,
  after,
  beforeAlt,
  afterAlt,
  beforeLabel = "Before",
  afterLabel = "After",
  ratio = "16 / 10",
  caption,
  class: className,
} = Astro.props;
---

<figure class:list={["ba-figure", className]}>
  <div class="ba" style={`--ratio: ${ratio}; --pos: 50%`} data-ba>
    <img class="ba-img" src={after} alt={afterAlt} loading="lazy" decoding="async" draggable="false" />
    <div class="ba-after-tag">
      <span class="ba-tag ba-tag--after">{afterLabel}</span>
    </div>
    <div class="ba-before">
      <img class="ba-img" src={before} alt={beforeAlt} loading="lazy" decoding="async" draggable="false" />
      <span class="ba-tag ba-tag--before">{beforeLabel}</span>
    </div>
    <div class="ba-line" aria-hidden="true">
      <span class="ba-knob">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 7l-5 5 5 5" /><path d="M15 7l5 5-5 5" />
        </svg>
      </span>
    </div>
    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      step="0.1"
      value="50"
      aria-label={`Compare ${beforeLabel.toLowerCase()} and ${afterLabel.toLowerCase()}`}
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-ba]").forEach((root) => {
    const range = root.querySelector<HTMLInputElement>(".ba-range");
    if (!range) return;
    const set = () => root.style.setProperty("--pos", `${range.value}%`);
    range.addEventListener("input", set);
    set();
  });
</script>

<style>
  .ba-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-basis: 100% !important;
  }
  .ba {
    position: relative;
    aspect-ratio: var(--ratio);
    border: 1px solid var(--cs-frame);
    border-radius: 20px;
    overflow: hidden;
    background: var(--cs-ph-bg);
    user-select: none;
    touch-action: pan-y;
  }
  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    pointer-events: none;
  }
  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  /* Each tag lives on its own side of the wipe, so the line covers it along
     with its screen: drag fully left and the before tag is gone, and vice versa */
  .ba-after-tag {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
    pointer-events: none;
  }
  .ba-tag {
    position: absolute;
    bottom: 14px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: #fff;
    background: rgba(22, 24, 26, 0.72);
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .ba-tag--before { left: 14px; }
  .ba-tag--after { right: 14px; }
  .ba-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(22, 24, 26, 0.12);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #fff;
    color: var(--cs-ink);
    box-shadow: 0 2px 10px rgba(22, 24, 26, 0.18), 0 0 0 1px rgba(22, 24, 26, 0.08);
    transition: transform 0.15s ease;
  }
  .ba:hover .ba-knob,
  .ba-range:focus-visible ~ .ba-line .ba-knob { transform: translate(-50%, -50%) scale(1.06); }
  /* Full-surface, invisible range input drives the wipe (pointer, touch, keys). */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba-range::-webkit-slider-thumb { -webkit-appearance: none; width: 1px; height: 100%; }
  .ba-range::-moz-range-thumb { width: 1px; height: 100%; border: 0; }
  @media (max-width: 600px) {
    .ba { border-radius: 14px; }
    .ba-tag { bottom: 8px; padding: 3px 7px; font-size: 10px; }
    .ba-tag--before { left: 8px; }
    .ba-tag--after { right: 8px; }
    .ba-knob { width: 34px; height: 34px; }
  }
  .ba:has(.ba-range:focus-visible) { outline: 2px solid var(--cs-link); outline-offset: 3px; }
  figcaption {
    font-size: 13px;
    color: var(--cs-muted);
  }
</style>
