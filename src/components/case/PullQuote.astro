---
import Kicker from "./Kicker.astro";

// A big rounded quote across the full width, with an optional kicker above.
export interface Props {
  label?: string;
  /** Grey aside after the label, on the same line. */
  sub?: string;
}
const { label, sub } = Astro.props;
---

<figure class="pull-quote">
  {
    label && (
      <Kicker as="figcaption">
        {label}
        {sub && <>&nbsp;<span class="sub">{sub}</span></>}
      </Kicker>
    )
  }
  <blockquote><slot /></blockquote>
</figure>

<style>
  .pull-quote {
    flex: 1 1 100%;
    width: 100%;
    /* --sp-quote above and below, whatever gap the parent stack uses */
    margin: calc(var(--sp-quote) - var(--gap, 0px)) 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .sub {
    font-size: 14px;
    color: var(--cs-soft);
  }
  blockquote {
    margin: 0;
    font-family: var(--cs-font-display);
    font-weight: 700;
    font-size: clamp(30px, 7vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--cs-ink);
  }
</style>
