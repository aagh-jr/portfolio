---
// Shared top nav, rendered on every page (BaseLayout and CaseStudyLayout).
// Top left, the name (home). Centered pills (Work, Lab, About, Resume), each a
// section of the home page, the current one dark: on home it follows the
// scroll, and none is lit on the hero; on a case study it's Work (Lab for the
// NPS gallery). Top right,
// Contact and a light/dark button. Ported from the paper hero
// (~/Developer/parchment). The theme itself is set before first paint by
// ThemeInit.astro in each layout's <head>.
import { getCollection } from "astro:content";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
const brandName = "Abel Angel";
// A project page lights the pill of the section its card sits in.
const project = (await getCollection("projects")).find((p) => p.data.href === path);
const inLab = project?.data.section === "lab";

const navLinks = [
  { label: "Work", section: "work", current: path.startsWith("/projects") && !inLab },
  { label: "Lab", section: "lab", current: inLab },
  { label: "About", section: "about", current: false },
  { label: "Resume", section: "resume", current: false },
];
---

<header class="site-header">
  <!-- One span per letter so the home page can spell the name out as you
       scroll off the hero. Elsewhere it's simply all there. -->
  <a
    class:list={["brand", !isHome && "visible"]}
    id="siteBrand"
    href="/"
    aria-label={brandName}
  >
    {brandName.split(" ").map((word, w) => (
      <span class="brand-word">
        {w > 0 && " "}
        {word.split("").map((ch) => (
          <span class="brand-letter" aria-hidden="true">{ch}</span>
        ))}
      </span>
    ))}
  </a>
  <nav class="site-nav" aria-label="Main">
    {
      navLinks.map((n) => (
        <a
          class="pill"
          href={`/#${n.section}`}
          data-section={n.section}
          aria-current={n.current ? "page" : undefined}
        >
          {n.label}
        </a>
      ))
    }
  </nav>
  <div class="site-corner">
    <a class="pill" href="mailto:abel.aagh@gmail.com">Contact</a>
    <button id="siteThemeBtn" class="theme-btn" type="button" aria-label="Switch to dark mode">
      <svg class="sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13" /></svg>
      <svg class="moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1z" /></svg>
    </button>
  </div>
</header>

<style>
  /* ── Fixed top strip, click-through so content scrolls beneath it; the
     pills and the theme button re-enable their own clicks. Tokens live on
     the header so no page's own --ink etc. is touched. ── */
  .site-header {
    --hdr-bg: #f5f5f2;
    --hdr-rule: #e3e2db;
    --hdr-ink: #1c1c18;
    --hdr-nav: #55554e;
    --hdr-current: #3f3f3a;
    --hdr-on: #fafaf8;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 80px;
    z-index: 50; /* above the case studies' sidebars (40), which start under it */
    pointer-events: none;
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 14px;
  }
  :global(:root[data-theme="dark"]) .site-header {
    --hdr-bg: #25241f;
    --hdr-rule: #36352f;
    --hdr-ink: #ecebe6;
    --hdr-nav: #b5b4ac;
    --hdr-current: #ecebe6;
    --hdr-on: #141412;
  }
  .site-nav {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .site-corner {
    position: absolute;
    top: 12px;
    right: 20px;
    display: flex;
    gap: 8px;
  }
  .pill,
  .theme-btn {
    pointer-events: auto;
  }

  /* The name, on the pills' row. Hidden on the home hero until scrolling
     spells it out (see the script below). */
  .brand {
    position: absolute;
    top: 12px;
    left: 20px;
    line-height: 32px;
    font-family: "Bianzhidai Pearl", system-ui, sans-serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.02em;
    white-space: pre;
    color: var(--hdr-ink);
    text-decoration: none;
    border-bottom: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .brand.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .brand:focus-visible {
    outline: 2px solid var(--hdr-ink);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* Letters still to land are hidden; the next pair shows grey first */
  .brand-letter {
    transition: opacity 0.25s ease, color 0.25s ease;
  }
  .brand-letter.is-pending {
    color: #b5b5b0;
  }
  .brand-letter.is-hidden {
    opacity: 0;
  }
  /* One pill per link; the current page's pill is dark */
  .pill {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--hdr-bg);
    box-shadow: inset 0 0 0 1px var(--hdr-rule);
    color: var(--hdr-nav);
    text-decoration: none;
    border-bottom: none; /* case-study CSS underlines links via border */
    transition: background 0.2s ease, color 0.2s ease;
  }
  .pill:hover {
    color: var(--hdr-ink);
  }
  .pill[aria-current] {
    background: var(--hdr-current);
    box-shadow: none;
    color: var(--hdr-on);
  }
  .pill:focus-visible,
  .theme-btn:focus-visible {
    outline: 2px solid var(--hdr-ink);
    outline-offset: 2px;
  }
  /* A square button showing the current mode: sun in light, moon in dark */
  .theme-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--hdr-bg);
    box-shadow: inset 0 0 0 1px var(--hdr-rule);
    color: var(--hdr-nav);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .theme-btn:hover {
    color: var(--hdr-ink);
  }
  .theme-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-btn .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-btn .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-btn .moon {
    display: block;
  }

  /* Narrower screens keep everything on one row: the name gives way a
     word at a time, then the pills shrink. Breakpoints are from the
     measured widths: pills 287px, Contact and the theme button 127px, the
     name 160px ("Abel" alone 64px), with 16px clear between them. */
  /* Too narrow for all of the name beside the centered pills: just "Abel" */
  @media (max-width: 679px) {
    .brand-word + .brand-word {
      display: none;
    }
  }
  /* Too narrow to center the pills on the page: one flex row, the pills
     centered in the room between the name and the corner */
  @media (max-width: 613px) {
    .site-header {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      box-sizing: border-box;
      padding: 12px 20px 0;
    }
    .brand,
    .site-nav,
    .site-corner {
      position: static;
    }
    .site-nav {
      flex: 1;
      flex-wrap: nowrap;
    }
  }
  /* No room for "Abel" either */
  @media (max-width: 549px) {
    .brand {
      display: none;
    }
  }
  /* Phones: smaller, tighter pills */
  @media (max-width: 461px) {
    .site-header {
      font-size: 13px;
      gap: 8px;
      padding-inline: 12px;
    }
    .site-nav,
    .site-corner {
      gap: 6px;
    }
    .pill {
      padding: 0 8px;
    }
  }
  /* The smallest phones */
  @media (max-width: 359px) {
    .site-nav,
    .site-corner {
      gap: 4px;
    }
    .pill {
      padding: 0 6px;
    }
  }
</style>

<script>
  import { scrollToFirstProject } from "../scripts/workScroll";
  // Light / dark: flips <html data-theme> and remembers it. Delegated, so it
  // keeps working after the View Transitions router swaps the header.
  function showTheme() {
    const dark = document.documentElement.dataset.theme === "dark";
    document
      .getElementById("siteThemeBtn")
      ?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
  }

  if (!window.__siteHeaderWired) {
    window.__siteHeaderWired = true;
    document.addEventListener("click", (e) => {
      if (!(e.target as Element).closest?.("#siteThemeBtn")) return;
      const t = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = t;
      try {
        localStorage.setItem("theme", t);
      } catch {}
      showTheme();
    });
    document.addEventListener("astro:page-load", showTheme);
    document.addEventListener("astro:page-load", initHomeHeader);

    // The home page's paper runs plain scripts with window-wide listeners and
    // an animation loop, so it can't be swapped in or out by the router: any
    // navigation to or from home is a full page load instead.
    document.addEventListener("astro:before-preparation", (e) => {
      const { from, to } = e as Event & { from: URL; to: URL };
      if (from.pathname === "/" || to.pathname === "/") e.preventDefault();
    });
  }
  showTheme();

  // ── Home only: the name spells itself out and the pills follow the scroll ──
  // The name lands over this fraction of a viewport of scrolling off the hero,
  // LETTERS_PER_STEP random letters at a time (grey first, then ink), and
  // plays back in reverse on the way up.
  const NAME_REVEAL_FRACTION = 0.9;
  const LETTERS_PER_STEP = 2;
  // A section is current once its top passes this far down the viewport.
  const SPY_LINE = 0.4;

  // Fisher–Yates shuffle: a fresh letter order on every page load.
  function shuffle<T>(items: T[]): T[] {
    const a = items.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function initHomeHeader() {
    const brand = document.getElementById("siteBrand");
    if (!brand || location.pathname !== "/") return;

    const letters = shuffle(Array.from(brand.querySelectorAll<HTMLElement>(".brand-letter")));
    const steps = Math.ceil(letters.length / LETTERS_PER_STEP);
    const pills = Array.from(document.querySelectorAll<HTMLElement>(".site-nav .pill"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const update = () => {
      const progress = reduced
        ? window.scrollY > 0 ? 1 : 0
        : Math.min(Math.max(window.scrollY / (window.innerHeight * NAME_REVEAL_FRACTION), 0), 1);
      const solid = progress > 0 ? Math.floor(progress * steps) * LETTERS_PER_STEP : 0;
      const pending = progress > 0 ? Math.min(solid + LETTERS_PER_STEP, letters.length) : 0;
      letters.forEach((el, i) => {
        el.classList.toggle("is-pending", i >= solid && i < pending);
        el.classList.toggle("is-hidden", i >= pending);
      });
      brand.classList.toggle("visible", pending > 0);

      // The last section whose top has passed the spy line is current; on the
      // hero, none. At the very bottom, the last section wins.
      const line = window.innerHeight * SPY_LINE;
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let current: string | undefined;
      pills.forEach((p) => {
        const sec = document.getElementById(p.dataset.section!);
        if (sec && (sec.getBoundingClientRect().top <= line || atBottom)) current = p.dataset.section;
      });
      pills.forEach((p) => {
        if (p.dataset.section === current) p.setAttribute("aria-current", "location");
        else p.removeAttribute("aria-current");
      });
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);

    // Already home: a pill just scrolls to its section, leaving the URL bare
    // so a reload starts on the paper again.
    pills.forEach((p) =>
      p.addEventListener("click", (e) => {
        const sec = document.getElementById(p.dataset.section!);
        if (!sec) return;
        e.preventDefault();
        const behavior = reduced ? "auto" : "smooth";
        if (p.dataset.section === "work") scrollToFirstProject(behavior);
        else sec.scrollIntoView({ behavior });
      }),
    );
  }

</script>
