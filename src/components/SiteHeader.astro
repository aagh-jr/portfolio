---
// Shared top nav + brand wordmark, rendered on every BaseLayout page.
// Home passes brandVisible={false} so its scroll-fade script reveals the
// wordmark instead; every other page shows it immediately.
export interface Props {
  brandVisible?: boolean;
}
const { brandVisible = true } = Astro.props;
const brandName = "Abel Angel";

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Contact", action: "contact" as const },
];
---

<header class="site-header">
  <a
    href="/"
    class:list={["brand-mark", brandVisible && "visible"]}
    id="brandMark"
    aria-hidden={brandVisible ? undefined : "true"}
    aria-label="Abel Angel"
  >
    <!-- One span per letter so the home page can reveal them in a random
         order as you scroll. Elsewhere they're simply all visible. -->
    {brandName.split("").map((ch) =>
      ch === " " ? " " : <span class="brand-letter" aria-hidden="true">{ch}</span>,
    )}
  </a>
  <nav class="top-nav">
    {
      navLinks.map((n) =>
        n.action === "contact" ? (
          <button class="nav-link nav-link--btn" type="button" data-contact-open>
            {n.label}
          </button>
        ) : (
          <a
            href={n.href}
            class="nav-link"
            target={n.external ? "_blank" : undefined}
            rel={n.external ? "noreferrer" : undefined}
          >
            {n.label}
          </a>
        ),
      )
    }
  </nav>
</header>

<!-- Brand heart kept in its own fixed layer so it never inherits the header's
     pointer/blend rules; mirrors the header's centring so it lines up. -->
<div class="brand-heart-layer" aria-hidden="true">
  <span class:list={["brand-heart", brandVisible && "visible"]} id="brandHeart">♥</span>
</div>

<!-- ── Contact pop-up: a centred grey card over the current page ── -->
<div class="contact-modal" id="contactModal" hidden>
  <div class="contact-backdrop" data-contact-close></div>
  <div class="contact-card" role="dialog" aria-modal="true" aria-label="Contact Abel Angel">
    <button class="contact-x" type="button" data-contact-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="contact-apps">
      <a class="contact-app" href="mailto:abel.aagh@gmail.com" aria-label="Email Abel">
        <span class="contact-app-icon contact-app-icon--mail">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7l9 6 9-6M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"></path>
          </svg>
        </span>
        <span class="contact-app-label">Email</span>
      </a>

      <a class="contact-app" href="https://www.linkedin.com/in/abel-a-gonzalez" target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <span class="contact-app-icon contact-app-icon--linkedin">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </span>
        <span class="contact-app-label">LinkedIn</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* Nav links + brand wordmark use Space Grotesk (matches the home design). */
  .nav-link,
  .brand-mark {
    font-family: "Space Grotesk", system-ui, sans-serif;
  }

  /* ── Fixed top strip: click-through so cards scroll beneath it; the nav and
     brand re-enable their own clicks. ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 132px;
    padding: 0 48px;
    box-sizing: border-box;
    z-index: 30;
    pointer-events: none;
  }
  .top-nav {
    position: absolute;
    top: 12px;
    right: 48px;
    display: flex;
    align-items: center;
    gap: 18px;
    pointer-events: auto;
  }
  .nav-link {
    font-size: 14.5px;
    font-weight: 400;
    -webkit-text-stroke: 0.35px currentColor;
    paint-order: stroke fill;
    color: #71717a;
    letter-spacing: -0.016em;
    transition: opacity 0.15s;
    text-decoration: none;
  }
  /* The Contact trigger is a <button> styled to match the anchor links. */
  .nav-link--btn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    line-height: inherit;
  }
  .nav-link:hover { opacity: 0.6; }

  /* Brand wordmark: hidden until scrolled on home (via brandVisible=false),
     always shown elsewhere. */
  .brand-mark {
    position: absolute;
    top: 12px;
    left: 72px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.016em;
    color: #1c1c18;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .brand-mark.visible {
    opacity: 1;
    pointer-events: auto;
  }
  /* Per-letter reveal (home only — the scroll script adds .is-hidden /
     .is-pending). Pending letters show grey, marking the next pair to land. */
  .brand-letter {
    transition: opacity 0.25s ease, color 0.25s ease;
  }
  .brand-letter.is-pending {
    color: #b5b5b0;
  }
  .brand-letter.is-hidden {
    opacity: 0;
  }

  .brand-heart-layer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    box-sizing: border-box;
    z-index: 31;
    pointer-events: none;
  }
  .brand-heart {
    position: absolute;
    top: 12px;
    left: 48px;
    font-size: 17px;
    line-height: 1.2;
    color: #a9cde9;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .brand-heart.visible { opacity: 1; }

  /* ── Contact modal ── */
  .contact-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .contact-modal[hidden] { display: none; }
  .contact-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 18, 0.28);
    backdrop-filter: blur(2px);
  }
  .contact-card {
    position: relative;
    width: 320px;
    max-width: calc(100vw - 48px);
    aspect-ratio: 1 / 1;
    background: #e5ebee;
    border: 1px solid #ccd4d8;
    border-radius: 24px;
    box-shadow: 0 30px 60px -20px rgba(20, 20, 18, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    animation: contactPop 0.28s cubic-bezier(0.2, 0, 0, 1);
  }
  @keyframes contactPop {
    from { opacity: 0; transform: scale(0.92) translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .contact-x {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #71717a;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    transition: color 0.15s, background 0.15s;
  }
  .contact-x:hover { color: #1c1c18; background: rgba(28, 28, 24, 0.08); }

  .contact-apps { display: flex; gap: 32px; }
  .contact-app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .contact-app-icon {
    width: 74px;
    height: 74px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow: 0 8px 18px -8px rgba(20, 20, 18, 0.5);
    transition: transform 0.18s ease;
  }
  .contact-app:hover .contact-app-icon { transform: translateY(-3px); }
  .contact-app-icon--mail { background: #1c1c18; }
  .contact-app-icon--linkedin { background: #0a66c2; }
  .contact-app-label {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #3f3f46;
  }

  /* ── Mobile: header flows normally at the top of the page ── */
  @media (max-width: 900px) {
    .site-header {
      position: static;
      min-height: 0;
      padding: 32px 24px 0;
    }
    .top-nav {
      position: static;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 16px 24px;
    }
    .nav-link { font-size: 18px; }
    .brand-mark { display: none; }
    .brand-heart-layer { display: none; }
  }
</style>

<script>
  // Contact pop-up wiring. Uses event delegation on `document` so it keeps
  // working across Astro View Transition navigations (the modal markup is
  // re-rendered per page, but these listeners persist). Guarded so it only
  // wires once.
  function wireContact() {
    if ((window as any).__contactWired) return;
    (window as any).__contactWired = true;

    const getModal = () => document.getElementById("contactModal");
    const open = () => {
      const m = getModal();
      if (!m) return;
      m.hidden = false;
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      const m = getModal();
      if (!m || m.hidden) return;
      m.hidden = true;
      document.body.style.overflow = "";
    };

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-contact-open]")) {
        e.preventDefault();
        open();
      } else if (t.closest("[data-contact-close]")) {
        close();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    // Never leave the modal (or a locked scroll) open across a navigation.
    document.addEventListener("astro:before-swap", close);
  }

  wireContact();
</script>
